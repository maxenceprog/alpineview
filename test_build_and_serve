#!/usr/bin/env bash
# Start the frontend dev server plus the build servers (redis + ewoksjob)
# and the /debug/* rebuild + COPC routes (test controls enabled).
# Usage: ./test_build_and_serve

set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"

cleanup() {
    echo ""
    echo "Stopping server…"
    kill "$FRONTEND_PID" 2>/dev/null || true
    wait "$FRONTEND_PID" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

echo "==> Starting frontend + build servers …"
cd "$ROOT/webapp"
npm run test_build_and_serve &
FRONTEND_PID=$!

echo ""
echo "Frontend : http://localhost:5173"
echo ""
wait "$FRONTEND_PID"

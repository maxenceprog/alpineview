#!/usr/bin/env bash
# Start alpineview_api plus the frontend dev server (which proxies the asset routes
# to it), the build servers (redis + ewoksjob) and the /debug/* rebuild + COPC routes
# (test controls enabled).
# Usage: ./test_build_and_serve

set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"

# shellcheck source=run_api
source "$ROOT/run_api"

cleanup() {
    echo ""
    echo "Stopping servers…"
    kill "$FRONTEND_PID" 2>/dev/null || true
    kill "$API_PID" 2>/dev/null || true
    wait "$FRONTEND_PID" 2>/dev/null || true
    wait "$API_PID" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

start_api

echo "==> Starting frontend + build servers …"
cd "$ROOT/webapp"
npm run test_build_and_serve &
FRONTEND_PID=$!

echo ""
echo "Frontend : http://localhost:5173"
echo "API      : http://localhost:${API_PORT}"
echo ""
wait "$FRONTEND_PID"

#!/usr/bin/env bash
# Start alpineview_api against the local asset tree (webapp/public), which the vite
# dev server proxies /tiles,/vegetation,/buildings,/dem to. Sourced by test_serve and
# test_build_and_serve; run it directly to serve the assets on their own.
# Usage: ./run_api

set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"

API_PORT="${ALPINEVIEW_API_PORT:-8000}"
export ALPINEVIEW_DATA_DIR="${ALPINEVIEW_DATA_DIR:-$ROOT/webapp/public}"
# Dev serves rebuilt tiles (test_build_and_serve's /debug/build) straight away; the
# API still 304s unchanged ones, so revalidating a tile costs a round trip, not a refetch.
export ALPINEVIEW_CACHE_CONTROL="${ALPINEVIEW_CACHE_CONTROL:-no-cache}"

start_api() {
    echo "==> Starting alpineview_api on 127.0.0.1:$API_PORT (data: $ALPINEVIEW_DATA_DIR) …"
    # Bound to loopback: only the vite dev proxy talks to it, never the network.
    # --reload-dir scopes the watcher: the default (cwd) would walk every built tile.
    python3 -m uvicorn alpineviewapi.main:app \
        --host 127.0.0.1 --port "$API_PORT" \
        --reload --reload-dir "$ROOT/alpineview_api/alpineviewapi" &
    API_PID=$!
}

# Only run when executed, not when sourced.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    trap 'kill "$API_PID" 2>/dev/null || true' EXIT INT TERM
    start_api
    wait "$API_PID"
fi

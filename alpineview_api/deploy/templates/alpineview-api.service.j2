[Unit]
Description=alpineview tile API
After=network.target

[Service]
User={{ app_user }}
Group={{ app_user }}
Environment=ALPINEVIEW_DATA_DIR={{ data_dir }}
Environment=ALPINEVIEW_ALLOWED_ORIGINS={{ allowed_origins }}
ExecStart={{ venv_dir }}/bin/uvicorn alpineviewapi.main:app --host 127.0.0.1 --port {{ api_port }} --workers {{ uvicorn_workers }}
Restart=on-failure
RestartSec=3

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths={{ data_dir }}
PrivateTmp=true

[Install]
WantedBy=multi-user.target

#!/usr/bin/env bash
# Start alpineview_api plus the frontend dev server (which proxies the asset
# routes to it). With --remote, assets come from the OVH S3 bucket instead of
# webapp/public and no local API is started.
# Usage: ./test_serve [--remote]

set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"

REMOTE=""
case "${1:-}" in
    --remote) REMOTE=1 ;;
    "") ;;
    *) echo "Usage: $0 [--remote]" >&2; exit 1 ;;
esac


if [[ -n "$REMOTE" ]]; then
    export ALPINEVIEW_REMOTE_ASSETS=1
fi

echo "==> Starting frontend …"
cd "$ROOT/webapp"
npm run dev

